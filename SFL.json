{
  "log": {
    "disabled": true
  },
  "dns": {
    "servers": [
      {
        "type": "https",
        "tag": "dns-direct",
        "server": "9.9.9.9"
      },
      {
        "type": "fakeip",
        "tag": "dns-fakeip",
        "inet4_range": "198.18.0.0/15"
      }
    ],
    "rules": [
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "server": "dns-fakeip"
      }
    ],
    "strategy": "ipv4_only",
    "optimistic": true
  },
  "http_clients": [
    {
      "tag": "default",
      "version": 2,
      "stream_receive_window": 0,
      "connection_receive_window": 0
    }
  ],
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 7890
    }
  ],
  "outbounds": [
    {
      "type": "selector",
      "tag": "Proxy",
      "outbounds": [
        "auto",
        "gemini",
        "{all}"
      ]
    },
    {
      "type": "urltest",
      "tag": "auto",
      "outbounds": [
        "{all}"
      ]
    },
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "vless",
      "tag": "gemini",
      "server": "withered-union-acac.weathered-moon-3b44.workers.dev",
      "server_port": 443,
      "uuid": "dd55a1e3-ee70-4aa6-8e48-6e5fa0ed03d4",
      "transport": {
        "path": "/upload",
        "type": "ws",
        "headers": {
          "Host": "withered-union-acac.weathered-moon-3b44.workers.dev"
        }
      },
      "tls": {
        "enabled": true,
        "server_name": "withered-union-acac.weathered-moon-3b44.workers.dev",
        "insecure": true,
        "utls": {
          "enabled": true,
          "fingerprint": "chrome"
        },
        "ech": {
          "enabled": true,
          "query_server_name": "cloudflare-ech.com"
        }
      },
      "network": "tcp"
    }
  ],
  "route": {
    "rules": [
      {
        "inbound": "mixed-in",
        "action": "sniff"
      },
      {
        "inbound": "mixed-in",
        "action": "resolve"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "port": 53
          },
          {
            "protocol": "dns"
          }
        ],
        "action": "hijack-dns"
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      },
      {
        "domain": [
          "signaler-pa.googleapis.com",
          "robinfrontend-pa.googleapis.com"
        ],
        "rule_set": "geosite-google-gemini",
        "outbound": "gemini"
      },
      {
        "rule_set": "geoip-ir",
        "outbound": "direct"
      },
      {
        "network": "udp",
        "action": "reject"
      }
    ],
    "rule_set": [
      {
        "type": "remote",
        "tag": [
          "geoip-ir",
          "geosite-google-gemini"
        ],
        "url": "https://github.com/Chocolate4U/Iran-sing-box-rules/raw/refs/heads/rule-set/{tag}.srs",
        "update_interval": "72h0m0s"
      }
    ],
    "auto_detect_interface": true,
    "default_domain_resolver": "dns-direct"
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "store_fakeip": true,
      "store_dns": true
    },
    "clash_api": {
      "external_controller": "127.0.0.1:9090"
    }
  }
}
