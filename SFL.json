      "tcp_fast_open": true,
      "uuid": "08df6635-3793-4eb0-af66-e40a5be76385",
      "packet_encoding": "",
      "network": "tcp",
      "tls": {
        "enabled": true,
        "server_name": "2s1o8VMS-Y2077Yu0dRmvPjAK5j.weATHeReD-MooN-3b44.wORkeRs.dev",
        "record_fragment": false,
        "insecure": false,
        "alpn": [
          "http/1.1"
        ],
        "utls": {
          "enabled": true,
          "fingerprint": "chrome"
        },
        "ech": {
          "enabled": true
        }
      },
      "transport": {
        "type": "ws",
        "path": "/vl/ZtBCIaa4AoOA6y3A07CQhL",
        "max_early_data": 2560,
        "early_data_header_name": "Sec-WebSocket-Protocol",
        "headers": {
          "Host": "2s1o8vms-y2077yu0drmvpjak5j.weathered-moon-3b44.workers.dev"
        }
      }
